# FLOWSHIELD Environment Variables Template
# Copy this file to .env and insert your API keys:
LLM_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Historical Disaster Intelligence (Optional Live API Endpoint & Token)
# Leave blank to use FlowShield's curated offline historical archive
VITE_HISTORICAL_DISASTER_API_KEY=your_historical_disaster_api_key_here
VITE_HISTORICAL_DISASTER_API_ENDPOINT=https://api.example.com/v1/disasters
